datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  role         Role     @default(STUDENT)
  hashedRt     String?  // Hash del Refresh Token para validar sesiones activas
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}