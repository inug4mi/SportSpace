datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  refreshToken String?  // Almacenado como hash en caso de rotación o revocación
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}